{
  "name": "@card-navi/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Japanese credit card optimization — 189 cards, reward rate comparison, store-specific recommendations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "card-navi-mcp": "dist/index.js",
    "card-navi-mcp-http": "dist/http-server.js"
  },
  "files": [
    "dist",
    "src/data"
  ],
  "scripts": {
    "build": "tsc",
