{
  "name": "@card-wize/mcp-server",
  "version": "0.2.0",
  "description": "MCP server for Japanese credit card optimization — 200+ cards, store-specific reward rate recommendations, card comparison, and detailed specs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "card-wize-mcp": "dist/index.js",
    "card-wize-mcp-http": "dist/http-server.js"
  },
  "files": [
    "dist",
    "src/data"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "seed": "node dist/db/seed.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "credit-card",
    "rewards",
    "japan",
    "card-wize",
    "cashback",
    "points",
    "fintech",
    "aeo"
  ],
  "author": "Synapse Arrows PTE. LTD.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synapse-arrows/card-wize-mcp"
  },
  "homepage": "https://card-nabi.vercel.app",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
